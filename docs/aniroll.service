[Unit]
Description=AniRoll Anime Streaming Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/aniweb
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx tsx /home/pi/aniweb/scripts/start-server.ts
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target